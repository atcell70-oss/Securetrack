<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="mobile-web-app-capable" content="yes">
<title>SecureTrack — Join</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow:wght@300;400;600;700&display=swap');
  :root {
    --bg: #0a0c0f; --surface: #111418; --border: #1e2530;
    --accent: #00ff88; --accent2: #00cfff; --danger: #ff4444;
    --text: #e2e8f0; --muted: #4a5568;
    --mono: 'Share Tech Mono', monospace; --sans: 'Barlow', sans-serif;
  }
  * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  body { background:var(--bg); color:var(--text); font-family:var(--sans); min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:24px; }
  body::before { content:''; position:fixed; inset:0; background:radial-gradient(ellipse at 20% 50%, rgba(0,255,136,0.04) 0%, transparent 60%), radial-gradient(ellipse at 80% 20%, rgba(0,207,255,0.04) 0%, transparent 60%); pointer-events:none; }
  .grid-bg { position:fixed; inset:0; background-image:linear-gradient(rgba(0,255,136,0.03) 1px, transparent 1px),linear-gradient(90deg, rgba(0,255,136,0.03) 1px, transparent 1px); background-size:40px 40px; pointer-events:none; }
  .container { width:100%; max-width:380px; position:relative; z-index:1; }
  .logo { text-align:center; margin-bottom:32px; }
  .logo svg { width:52px; height:52px; margin-bottom:10px; }
  .logo h1 { font-family:var(--mono); font-size:18px; letter-spacing:4px; color:var(--accent); text-transform:uppercase; }
  .logo p { font-size:10px; color:var(--muted); letter-spacing:2px; text-transform:uppercase; margin-top:4px; font-family:var(--mono); }
  .card { background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:24px; position:relative; overflow:hidden; }
  .card::before { content:''; position:absolute; top:0; left:0; right:0; height:1px; background:linear-gradient(90deg, transparent, var(--accent), transparent); opacity:0.4; }
  .section-label { font-family:var(--mono); font-size:10px; color:var(--accent); letter-spacing:3px; text-transform:uppercase; margin-bottom:18px; display:flex; align-items:center; gap:8px; }
  .section-label::after { content:''; flex:1; height:1px; background:var(--border); }
  .field { margin-bottom:14px; }
  .field label { display:block; font-size:10px; color:var(--muted); letter-spacing:1px; text-transform:uppercase; margin-bottom:6px; font-family:var(--mono); }
  .field input { width:100%; background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:13px 14px; color:var(--text); font-family:var(--mono); font-size:16px; outline:none; transition:border-color 0.2s; -webkit-appearance:none; }
  .field input:focus { border-color:var(--accent); }
  .field input::placeholder { color:var(--muted); font-size:12px; }
  .btn { width:100%; padding:15px; border:none; border-radius:8px; font-family:var(--mono); font-size:12px; letter-spacing:2px; text-transform:uppercase; cursor:pointer; transition:all 0.2s; margin-top:6px; }
  .btn-primary { background:var(--accent); color:#000; font-weight:700; }
  .btn-primary:active { transform:scale(0.98); }
  .btn-primary:disabled { opacity:0.4; }
  .btn-danger { background:transparent; color:var(--danger); border:1px solid var(--danger); margin-top:10px; }
  .status-screen { display:none; }
  .pulse-wrap { display:flex; flex-direction:column; align-items:center; padding:16px 0; gap:14px; }
  .pulse-dot { width:18px; height:18px; background:var(--accent); border-radius:50%; position:relative; animation:pa 2s infinite; }
  .pulse-dot::before,.pulse-dot::after { content:''; position:absolute; inset:0; border-radius:50%; border:2px solid var(--accent); animation:rp 2s infinite; }
  .pulse-dot::after { animation-delay:1s; }
  @keyframes pa { 0%,100%{opacity:1} 50%{opacity:0.7} }
  @keyframes rp { 0%{transform:scale(1);opacity:0.8} 100%{transform:scale(3.5);opacity:0} }
  .status-text { font-family:var(--mono); font-size:11px; color:var(--accent); letter-spacing:2px; text-transform:uppercase; }
  .coords { font-family:var(--mono); font-size:11px; color:var(--muted); text-align:center; line-height:1.9; }
  .coords span { color:var(--accent2); }
  .user-badge { display:flex; align-items:center; gap:10px; background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:10px 14px; margin-bottom:14px; }
  .ubdot { width:8px; height:8px; background:var(--accent); border-radius:50%; animation:pa 2s infinite; flex-shrink:0; }
  .ubname { font-family:var(--mono); font-size:13px; }
  .notice { background:rgba(0,207,255,0.05); border:1px solid rgba(0,207,255,0.15); border-radius:8px; padding:11px; margin-top:14px; }
  .notice p { font-size:10px; color:var(--accent2); font-family:var(--mono); line-height:1.7; }
  .error-msg { background:rgba(255,68,68,0.08); border:1px solid rgba(255,68,68,0.2); border-radius:8px; padding:11px; font-family:var(--mono); font-size:11px; color:var(--danger); margin-top:10px; display:none; line-height:1.6; }
  .install-hint { margin-top:18px; text-align:center; font-size:10px; color:var(--muted); font-family:var(--mono); line-height:1.9; }
  .install-hint strong { color:var(--accent2); }
  .wl-badge { font-family:var(--mono); font-size:10px; padding:3px 8px; border-radius:4px; }
  .wl-on { background:rgba(0,255,136,0.1); color:var(--accent); }
  .wl-off { background:rgba(255,68,68,0.1); color:var(--danger); }
</style>
</head>
<body>
<div class="grid-bg"></div>
<div class="container">
  <div class="logo">
    <svg viewBox="0 0 52 52" fill="none">
      <circle cx="26" cy="26" r="25" stroke="#00ff88" stroke-width="1" opacity="0.3"/>
      <circle cx="26" cy="20" r="7" fill="#00ff88" opacity="0.9"/>
      <path d="M26 27 L20 40 Q26 36 32 40 Z" fill="#00ff88" opacity="0.9"/>
      <circle cx="26" cy="20" r="3" fill="#0a0c0f"/>
    </svg>
    <h1>SecureTrack</h1>
    <p>Encrypted Location</p>
  </div>

  <div class="card" id="joinScreen">
    <div class="section-label">Connect</div>
    <div class="field">
      <label>Your Name / Callsign</label>
      <input type="text" id="userName" placeholder="e.g. Alpha, Unit-3..." autocomplete="off" autocorrect="off" spellcheck="false"/>
    </div>
    <div class="field">
      <label>Access Code</label>
      <input type="password" id="accessCode" placeholder="Code from your admin" autocomplete="off"/>
    </div>
    <div class="field">
      <label>Server URL</label>
      <input type="url" id="serverUrl" placeholder="https://your-server.com" autocomplete="off" autocorrect="off" autocapitalize="off"/>
    </div>
    <button class="btn btn-primary" id="joinBtn" onclick="startTracking()">▶ Start Transmitting</button>
    <div class="error-msg" id="errorMsg"></div>
    <div class="install-hint">
      For background tracking:<br>
      <strong>iPhone:</strong> Share → Add to Home Screen<br>
      <strong>Android:</strong> Menu → Add to Home Screen
    </div>
  </div>

  <div class="card status-screen" id="statusScreen">
    <div class="section-label">Transmitting</div>
    <div class="user-badge">
      <div class="ubdot"></div>
      <div class="ubname" id="activeUserName">—</div>
    </div>
    <div class="pulse-wrap">
      <div class="pulse-dot"></div>
      <div class="status-text" id="statusText">Acquiring signal...</div>
      <div class="coords" id="coordsDisplay">Waiting for GPS lock...</div>
      <div id="wlBadge"></div>
    </div>
    <div class="notice">
      <p>⚠ Keep this screen open or add to Home Screen for background tracking. Do not force-close.</p>
    </div>
    <button class="btn btn-danger" onclick="stopTracking()">■ Stop & Disconnect</button>
  </div>
</div>

<script>
  let watchId=null, sendInterval=null, wakeLock=null, lastCoords=null;
  const INTERVAL = 15000;

  window.onload = () => {
    const s = JSON.parse(localStorage.getItem('st_cfg')||'{}');
    if(s.name) document.getElementById('userName').value = s.name;
    if(s.server) document.getElementById('serverUrl').value = s.server;
  };

  async function acquireWakeLock() {
    try {
      if('wakeLock' in navigator) {
        wakeLock = await navigator.wakeLock.request('screen');
        document.getElementById('wlBadge').innerHTML='<span class="wl-badge wl-on">⚡ Screen active</span>';
        wakeLock.addEventListener('release',()=>{
          document.getElementById('wlBadge').innerHTML='<span class="wl-badge wl-off">⚠ Reopen to reactivate</span>';
          wakeLock=null;
        });
      }
    } catch(e){}
  }

  function showError(m) {
    const e=document.getElementById('errorMsg');
    e.textContent=m; e.style.display='block';
  }

  async function sendLocation(coords) {
    const name=document.getElementById('userName').value.trim();
    const code=document.getElementById('accessCode').value.trim();
    const server=document.getElementById('serverUrl').value.trim();
    try {
      const r = await fetch(server+'/location',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({name,lat:coords.latitude,lon:coords.longitude,acc:coords.accuracy,ts:Date.now(),code})
      });
      document.getElementById('statusText').textContent = r.ok ? 'Signal transmitting' : 'Server error — retrying';
    } catch(e) {
      document.getElementById('statusText').textContent = 'Connection lost — retrying';
    }
  }

  function updateCoords(c) {
    document.getElementById('coordsDisplay').innerHTML=
      `LAT <span>${c.latitude.toFixed(5)}</span><br>LON <span>${c.longitude.toFixed(5)}</span><br>ACC <span>±${Math.round(c.accuracy)}m</span>`;
  }

  async function startTracking() {
    document.getElementById('errorMsg').style.display='none';
    const name=document.getElementById('userName').value.trim();
    const code=document.getElementById('accessCode').value.trim();
    const server=document.getElementById('serverUrl').value.trim();
    if(!name){showError('Enter your name or callsign.');return;}
    if(!code){showError('Enter the access code.');return;}
    if(!server||!server.startsWith('https://')){showError('Server URL must start with https://');return;}
    localStorage.setItem('st_cfg',JSON.stringify({name,server}));
    const btn=document.getElementById('joinBtn');
    btn.disabled=true; btn.textContent='Requesting GPS...';
    if(!navigator.geolocation){showError('GPS not available.');btn.disabled=false;btn.textContent='▶ Start Transmitting';return;}
    navigator.geolocation.getCurrentPosition(async(pos)=>{
      document.getElementById('joinScreen').style.display='none';
      document.getElementById('statusScreen').style.display='block';
      document.getElementById('activeUserName').textContent=name;
      await acquireWakeLock();
      lastCoords=pos.coords; updateCoords(pos.coords); await sendLocation(pos.coords);
      watchId=navigator.geolocation.watchPosition(
        (p)=>{lastCoords=p.coords;updateCoords(p.coords);},
        ()=>{document.getElementById('statusText').textContent='GPS weak — retrying';},
        {enableHighAccuracy:true,maximumAge:10000,timeout:30000}
      );
      sendInterval=setInterval(()=>{if(lastCoords)sendLocation(lastCoords);},INTERVAL);
      document.addEventListener('visibilitychange',async()=>{
        if(document.visibilityState==='visible'&&!wakeLock) await acquireWakeLock();
      });
    },(err)=>{
      let m='GPS error. ';
      if(err.code===1)m+='Allow location in browser settings.';
      else if(err.code===2)m+='No signal — try outdoors.';
      else m+='Timeout — try again.';
      showError(m); btn.disabled=false; btn.textContent='▶ Start Transmitting';
    },{enableHighAccuracy:true,timeout:15000});
  }

  function stopTracking() {
    if(watchId) navigator.geolocation.clearWatch(watchId);
    if(sendInterval) clearInterval(sendInterval);
    if(wakeLock) wakeLock.release();
    watchId=sendInterval=wakeLock=lastCoords=null;
    document.getElementById('statusScreen').style.display='none';
    document.getElementById('joinScreen').style.display='block';
    const btn=document.getElementById('joinBtn');
    btn.disabled=false; btn.textContent='▶ Start Transmitting';
  }
</script>

</body>
</html>
